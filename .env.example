# Copy this file to .env and replace all placeholder values.
# This academic integration accepts TEST MODE credentials only.
PAYMENT_ENVIRONMENT=test
PAYMONGO_SECRET_KEY=sk_test_replace_with_your_test_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_replace_with_your_test_public_key
PAYMONGO_WEBHOOK_SECRET=replace_with_your_test_webhook_secret

# Local frontend origin used for Checkout success/cancel URLs and CSRF checks.
APP_BASE_URL=http://localhost:5173
API_PORT=3001

# Replace both demo passwords before exposing the development server.
ADMIN_EMAIL=owner@printhub.test
ADMIN_PASSWORD=replace-with-a-long-admin-password
STAFF_EMAIL=staff@printhub.test
STAFF_PASSWORD=replace-with-a-long-staff-password
